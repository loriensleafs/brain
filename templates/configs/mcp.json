{
  "mcpServers": {
    "brain": {
      "command": "bun",
      "args": ["run", "./apps/mcp/src/index.ts"],
      "env": {
        "BRAIN_TRANSPORT": "stdio"
      }
    },
    "serena": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server"]
    }
  }
}
